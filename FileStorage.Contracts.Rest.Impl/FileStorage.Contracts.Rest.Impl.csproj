<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net6.0 — для проектов, которые ещё не перешли на .NET 9 -->
    <TargetFrameworks>net6.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Version>9.0.29</Version>
    <Authors>Stanislav Batyrgareev</Authors>
    <Description>Fixed the return of Stream in the class FileStorageRestService.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageIcon></PackageIcon>
    <PackageIconUrl />
    <PackageProjectUrl>http://bsasearch.ru/filestorage.html</PackageProjectUrl>
    <Copyright>Stanislav Batyrgareev</Copyright>
    <Title>FileStorage.Contracts.Rest</Title>
    <RepositoryUrl>https://github.com/S-DyX/FileStorage.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>file storage rest client bsa filestorage</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>$(MSBuildProjectDirectory)\FileStorage.Contracts.Rest.Impl.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Service.Registry" Version="9.0.47" />
  </ItemGroup>

  <!-- Service.Registry 9.x собран только под net9.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="Service.Registry" Version="6.0.47" />
  </ItemGroup>

</Project>
