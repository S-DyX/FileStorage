<?xml version="1.0" encoding="utf-8" ?>
<!-- Логирование службы bsa-filestorage на сервере (пакеты deb/rpm и Docker-образ).
     Файлы: Info и выше (в том числе строка на каждый HTTP-запрос), отдельно ошибки; ротация по кругу:
     файл до 10 МБ, всего не больше 50 файлов на каждый лог (текущий + 49 архивных).
     Консоль (журнал systemd или docker logs): только предупреждения, ошибки и запуск/остановка.
     Для отладки: minlevel="Trace" у правила FlatFile-Info; NLog перечитывает файл сам. -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true">

  <targets>
    <target xsi:type="Console"
            name="Console"
            layout="${uppercase:${level}} ${logger} ${message} ${exception:format=tostring}" />

    <!-- по кругу: файл до 10 МБ, затем архив .00 (самый новый) ... .48; всего не больше 50 файлов -->
    <target xsi:type="File"
            name="FlatFile-Info"
            layout="${longdate} ${uppercase:${level}} ${logger} ${message}"
            fileName="/var/log/bsa/FileStorage.Api.Host/Info.log"
            archiveFileName="/var/log/bsa/FileStorage.Api.Host/Info.{##}.log"
            archiveAboveSize="10485760"
            archiveNumbering="Rolling"
            maxArchiveFiles="49"
            keepFileOpen="true"
            concurrentWrites="false"
            encoding="UTF-8" />

    <!-- по кругу: файл до 10 МБ, затем архив .00 (самый новый) ... .48; всего не больше 50 файлов -->
    <target xsi:type="File"
            name="FlatFile-Error"
            layout="${longdate} ${uppercase:${level}} ${logger} ${message} ${exception:format=tostring}"
            fileName="/var/log/bsa/FileStorage.Api.Host/Errors.log"
            archiveFileName="/var/log/bsa/FileStorage.Api.Host/Errors.{##}.log"
            archiveAboveSize="10485760"
            archiveNumbering="Rolling"
            maxArchiveFiles="49"
            keepFileOpen="true"
            concurrentWrites="false"
            encoding="UTF-8" />
  </targets>

  <rules>
    <!-- запуск и остановка хоста — в файл и в консоль -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="Console,FlatFile-Info" final="true" />
    <!-- служебные сообщения ASP.NET Core и HttpClient ниже Warning не пишем -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Info" writeTo="FlatFile-Info" />
    <logger name="*" minlevel="Warn" writeTo="Console" />
    <logger name="*" minlevel="Error" writeTo="FlatFile-Error" />
  </rules>
</nlog>
