<?xml version="1.0" encoding="utf-8" ?>
<!-- Логирование службы bsa-filestorage на сервере.
     Файлы: Info и выше (в том числе строка на каждый HTTP-запрос), отдельно ошибки.
     Консоль (журнал systemd, journalctl -u bsa-filestorage): только предупреждения и ошибки,
     чтобы не дублировать файлы. Для отладки: minlevel="Trace" у правила FlatFile-Info. -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true">

  <targets>
    <target xsi:type="Console"
            name="Console"
            layout="${uppercase:${level}} ${logger} ${message} ${exception:format=tostring}" />

    <target xsi:type="File"
            name="FlatFile-Info"
            layout="${time} ${uppercase:${level}} ${logger} ${message}"
            fileName="/var/log/bsa/FileStorage.Api.Host/${shortdate}-Info.log"
            keepFileOpen="false"
            encoding="UTF-8" />

    <target xsi:type="File"
            name="FlatFile-Error"
            layout="${time} ${uppercase:${level}} ${logger} ${message} ${exception:format=tostring}"
            fileName="/var/log/bsa/FileStorage.Api.Host/${shortdate}-Errors.log"
            keepFileOpen="false"
            encoding="UTF-8" />
  </targets>

  <rules>
    <!-- запуск и остановка хоста — в файл и в журнал systemd -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="Console,FlatFile-Info" final="true" />
    <!-- служебные сообщения ASP.NET Core и HttpClient ниже Warning не пишем -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Info" writeTo="FlatFile-Info" />
    <logger name="*" minlevel="Warn" writeTo="Console" />
    <logger name="*" minlevel="Error" writeTo="FlatFile-Error" />
  </rules>
</nlog>
