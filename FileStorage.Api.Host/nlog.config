<?xml version="1.0" encoding="utf-8" ?>
<!-- Логирование для отладки: уровень Trace, вывод в консоль.
     На сервере (пакеты deb/rpm, Docker-образ) используется Install/config/nlog.config.
     Ротация по кругу: файл до 10 МБ, всего не больше 50 файлов на каждый лог (текущий + 49 архивных). -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true">

  <targets>
    <target xsi:type="ColoredConsole"
            name="ColoredConsole-Trace"
            layout="${time} ${uppercase:${level}} ${message} ${exception:format=message}" 
            useDefaultRowHighlightingRules="true" />

    <!-- по кругу: файл до 10 МБ, затем архив .00 (самый новый) ... .48; всего не больше 50 файлов -->
    <target xsi:type="File"
            name="FlatFile-Trace"
            layout="${longdate} ${uppercase:${level}} ${logger} ${message}"
            fileName="/var/log/bsa/FileStorage.Api.Host/Trace.log"
            archiveFileName="/var/log/bsa/FileStorage.Api.Host/Trace.{##}.log"
            archiveAboveSize="10485760"
            archiveNumbering="Rolling"
            maxArchiveFiles="49"
            keepFileOpen="true"
            concurrentWrites="false"
            encoding="UTF-8" />

    <!-- по кругу: файл до 10 МБ, затем архив .00 (самый новый) ... .48; всего не больше 50 файлов -->
    <target xsi:type="File"
            name="FlatFile-Error"
            layout="${longdate} ${uppercase:${level}} ${logger} ${message} ${exception:format=tostring}"
            fileName="/var/log/bsa/FileStorage.Api.Host/Errors.log"
            archiveFileName="/var/log/bsa/FileStorage.Api.Host/Errors.{##}.log"
            archiveAboveSize="10485760"
            archiveNumbering="Rolling"
            maxArchiveFiles="49"
            keepFileOpen="true"
            concurrentWrites="false"
            encoding="UTF-8" />
  </targets>

  <rules>
    <logger name="*" minlevel="Trace" writeTo="ColoredConsole-Trace" />
    <logger name="*" minlevel="Trace" writeTo="FlatFile-Trace" />
    <logger name="*" minlevel="Error" writeTo="FlatFile-Error" />
  </rules>
</nlog>